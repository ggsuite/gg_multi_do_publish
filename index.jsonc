{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_multi_do_publish",

  // 1-2 sentence summary about this repo.
  "summary": "Multi-repo publish orchestrator of the gg_multi tool family: publishes all ticket repos in dependency order with skip checks, resume and rollback.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "do publish, do publish --merge-only, can publish; --continue, --restart",
    "do configure-publish: increments and merge messages of all repos up front via PublishPlanner",
    "skip checks, first-publish gate, pub.dev/npm registry checkers",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_multi_core": "PublishPlanner, PublishSkipCheck, TicketState, WorkspaceUtils, cleanUpTicket",
      "gg_multi_commit": "DidCommitCommand, DoPushCommand in can publish / do publish",
      "gg_one": "per-repo publish: DoPublish, CanPublish, CanMerge, CanCommit, DoUpgradeDeps, NpmLoggedIn",
      "gg_localize_refs": "UnlocalizeRefs before publish",
      "gg_local_package_dependencies": "SortedProcessingList: dependency order",
      "gg_publish": "publish helpers",
      "gg_git": "git state, branches",
      "gg_lang": "LanguageCatalog, publish targets",
      "gg_process": "process runner",
      "gg_args": "command base",
      "gg_status_printer": "progress output",
      "gg_console_colors": "colored output",
      "gg_log": "GgLog",
      "dna_ggsuite": "dev: DNA layer: guides, templates",
      "helix": "dev: runDnaTest",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_multi": "registers do publish, can publish, do configure-publish",
    },
  },
}
